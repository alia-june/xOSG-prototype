{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upw:request:0.1",
  "type": "object",
  "required": ["protocol", "request_id", "kind"],
  "properties": {
    "protocol": {"const": "upw/0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["describe", "operations", "schema", "version", "status", "invoke"]},
    "operation_id": {"type": "string", "minLength": 1},
    "input": {"type": "object"},
    "provenance": {"type": "object"},
    "authority_context": {"type": "object"},
    "options": {
      "type": "object",
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 3600000}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "invoke"}}},
      "then": {"required": ["operation_id", "input"]}
    }
  ]
}
